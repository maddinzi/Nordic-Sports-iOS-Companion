# Xcode (the project and Info.plist are generated from project.yml by XcodeGen)
*.xcodeproj/
App/Info.plist
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager / CocoaPods
.build/
.swiftpm/
Pods/

# Shared framework built from the Companion repo (Kotlin Multiplatform)
Frameworks/*.xcframework
# Generated from the Companion's strings.xml on CI (tools/generate_strings.py)
App/Localizable.xcstrings
App/Texts/
App/NordicSportsCompanion.entitlements

# Secrets (never commit)
*.xcconfig.local
Secrets.xcconfig
GoogleService-Info.plist
*.p12
*.mobileprovision
.env

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/

# Spike logs shared from the iPhone (personal data, GPS positions)
logs/
